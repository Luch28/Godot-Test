extends CharacterBody3D

# Ноды
@onready var head = $CameraHolder
@onready var cam = $CameraHolder/Camera3D
@onready var raycast = $CameraHolder/Camera3D/RayCast3D

# Переменные движения
var accel = 6
var SPEED = 5.0
var JUMP_VELOCITY = 4.5
var crouched = false 
var input_dir = Vector3(0,0,0) 
var direction = Vector3() 
var sens = 0.005
var gravity = ProjectSettings.get_setting("physics/3d/default_gravity")

# Переменные для системы подбора объектов
var hold_object: RigidBody3D = null
var throw_force = 10.0
var hold_position: Node3D

func _ready():
	Input.set_mouse_mode(Input.MOUSE_MODE_CAPTURED)
	
	# Настройка позиции удержания объекта
	hold_position = Node3D.new()
	hold_position.name = "HoldPosition"
	cam.add_child(hold_position)
	hold_position.position = Vector3(0, 0, -2)  # Объект будет перед камерой
	
	# Настройка RayCast3D :cite[3]:cite[9]
	raycast.enabled = true
	raycast.collide_with_areas = true  # Может обнаруживать Area3D
	raycast.collide_with_bodies = true  # Может обнаруживать PhysicsBody3D
	raycast.target_position = Vector3(0, 0, -3)  # Дальность 3 метра
	# Убедитесь, что collision_mask RayCast совпадает со слоем ваших объектов

func _input(event):
	if Input.is_action_just_pressed("ui_cancel"):
		if Input.get_mouse_mode() == Input.MOUSE_MODE_CAPTURED:
			Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE)
		else:
			Input.set_mouse_mode(Input.MOUSE_MODE_CAPTURED)
			
	if Input.get_mouse_mode() == Input.MOUSE_MODE_CAPTURED:
		if event is InputEventMouseMotion:
			head.rotate_y(-event.relative.x * sens)
			cam.rotate_x(-event.relative.y * sens)
			cam.rotation.x = clamp(cam.rotation.x, deg_to_rad(-89), deg_to_rad(89))
	
	if event is InputEventMouseButton and event.pressed:
		match event.button_index:
			MOUSE_BUTTON_LEFT: 
				if hold_object:
					release_object() 
				else:
					pick_up_object() 
			
			MOUSE_BUTTON_RIGHT:
				if hold_object:
					throw_object(true)

func pick_up_object():
	if raycast.is_colliding():
		# Получаем коллайдер, с которым столкнулся луч :cite[9]
		var collider = raycast.get_collider()
		print("Смотрю на: ", collider.name)  # Для отладки
		
		# Проверяем, является ли коллайдер RigidBody3D :cite[2]
		if collider is RigidBody3D:
			hold_object = collider
			
			# Сохраняем оригинальные свойства :cite[2]
			hold_object.set_meta("original_collision_mask", hold_object.collision_mask)
			hold_object.set_meta("original_collision_layer", hold_object.collision_layer)
			hold_object.set_meta("original_gravity", hold_object.gravity_scale)
			
			# Отключаем физику для удержания
			hold_object.freeze = true
			hold_object.collision_mask = 0  # Отключаем коллизии
			hold_object.collision_layer = 0
			hold_object.gravity_scale = 0   # Отключаем гравитацию
			
			print("Успешно поднял: ", hold_object.name)

func release_object():
	if hold_object:
		# Восстанавливаем оригинальные свойства :cite[2]
		hold_object.freeze = false
		hold_object.collision_mask = hold_object.get_meta("original_collision_mask", 1)
		hold_object.collision_layer = hold_object.get_meta("original_collision_layer", 1)
		hold_object.gravity_scale = hold_object.get_meta("original_gravity", 1.0)
		
		print("Отпустил: ", hold_object.name)
		hold_object = null

func throw_object(strong_throw: bool = false):
	if hold_object:
		hold_object.freeze = false
		hold_object.collision_mask = hold_object.get_meta("original_collision_mask", 1)
		hold_object.collision_layer = hold_object.get_meta("original_collision_layer", 1)
		hold_object.gravity_scale = hold_object.get_meta("original_gravity", 1.0)
		
		# Применяем силу броска :cite[2]
		var throw_power = throw_force * 2.0 if strong_throw else throw_force
		hold_object.linear_velocity = cam.global_transform.basis.z * -throw_power
		
		print("Бросил: ", hold_object.name)
		hold_object = null

func _physics_process(delta):
	# Применяем гравитацию
	if not is_on_floor():
		velocity.y -= gravity * delta
	else:
		if Input.is_action_just_pressed("ui_accept"):
			velocity.y = JUMP_VELOCITY
	
	# Обрабатываем движение
	input_dir = Input.get_vector("+a", "+d", "+w", "+s")
	direction = (head.transform.basis * Vector3(input_dir.x, 0, input_dir.y)).normalized()
 
	velocity.x = lerp(velocity.x, direction.x * SPEED, accel * delta)
	velocity.z = lerp(velocity.z, direction.z * SPEED, accel * delta)
	
	move_and_slide()

	# Если держим объект, перемещаем его вместе с позицией удержания :cite[2]
	if hold_object:
		hold_object.global_transform.origin = hold_position.global_transform.origin

# Вспомогательные функции для взаимодействия с объектами
func can_interact() -> bool:
	return raycast.is_colliding() and raycast.get_collider() is RigidBody3D

func get_looking_at_object() -> RigidBody3D:
	if raycast.is_colliding():
		var collider = raycast.get_collider()
		if collider is RigidBody3D:
			return collider
	return null
